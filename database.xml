<?xml version="1.0" encoding="UTF-8"?>
<database>
    <global>
        <table name="mail_journal_outbox">
            <field type="string" length="50" primary="true">id</field>
            <field type="datetime">create_date</field>
            <field type="datetime" nullable="true" default="null">send_date</field>

            <field type="string" length="1000" nullable="true" default="null">subject</field>
            <field type="text" nullable="true" default="null">body_html</field>
            <field type="text" nullable="true" default="null">body_text</field>

            <field type="string" length="255" nullable="true" default="null">mail_from</field>
            <field type="string" length="255" nullable="true" default="null">mail_from_name</field>
            <field type="text" nullable="true" default="null">mail_to</field>
            <field type="text" nullable="true" default="null">reply_to</field>
            <field type="text" nullable="true" default="null">mail_cc</field>
            <field type="text" nullable="true" default="null">mail_bcc</field>
            <field type="boolean" default="1">is_html</field>

            <field type="string" length="255" nullable="true" default="null">source_event</field>
            <field type="json" nullable="true" default="null">meta</field>

            <field type="boolean" default="0">archived</field>
            <field type="datetime" nullable="true" default="null">archive_date</field>

            <index>create_date</index>
            <index>archived</index>
        </table>

        <table name="mail_journal_outbox_attachments">
            <field type="string" length="50" primary="true">id</field>
            <field type="string" length="50">mail_id</field>
            <field type="datetime">create_date</field>

            <field type="string" length="255">filename</field>
            <field type="string" length="255" nullable="true" default="null">mime_type</field>
            <field type="bigint" nullable="true" default="null">filesize</field>
            <field type="string" length="1000" nullable="true" default="null">path</field>

            <index>mail_id</index>
            <index>create_date</index>
        </table>
    </global>
</database>
